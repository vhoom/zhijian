    <application
        android:name=".ZhijianApplication"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zhijian">
        <!-- Android 16 大屏继续遵循页面方向限制，止间所有操作保持竖屏。 -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <!-- 唯一对外 Activity 入口；其余 Activity 不对其他应用开放。 -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.activity.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Zhijian"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.activity.RulesGroupActivity"
            android:exported="false"
            android:label="@string/rules_group_title"
            android:theme="@style/Theme.Zhijian" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.activity.RuleGroupEditActivity"
            android:exported="false"
            android:theme="@style/Theme.Zhijian.RuleEditor"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.activity.AppPolicyActivity"
            android:exported="false"
            android:theme="@style/Theme.Zhijian.RuleEditor" />
        <!-- 设置页有数字输入框，键盘弹起时要压缩可视区，否则下面的行会被挡住。 -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.activity.SettingsActivity"
            android:exported="false"
            android:label="@string/bar_settings"
            android:theme="@style/Theme.Zhijian"
            android:windowSoftInputMode="adjustResize" />
        <!-- 关于文本与本地诊断仅允许应用内打开。 -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.about.AboutDocumentActivity"
            android:exported="false"
            android:theme="@style/Theme.Zhijian" />
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.diagnostics.DiagnosticsActivity"
            android:exported="false"
            android:theme="@style/Theme.Zhijian" />
        <!-- 应用内开发者预览在页面入口检查 Debug 构建。 -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.preview.DeveloperPreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.Zhijian" />
        <!-- 独立任务覆盖目标应用；不出现在最近任务中，结束后露出原应用任务。 -->
        <activity
            android:screenOrientation="portrait"
            android:name=".ui.interception.InterceptionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="github.vhoom.zhijian.interception"
            android:theme="@style/Theme.Zhijian.Interception" />
        <service
            android:name=".runtime.usage.UsageArchiveJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- 仅系统持有 BIND_ACCESSIBILITY_SERVICE 权限，开启与关闭均由用户在系统设置中完成。 -->
        <service
            android:name=".accessibility.ZhijianAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/zhijian_accessibility_service" />
        </service>
    </application>

</manifest>
