<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.App.Card.RuleEditor"
    android:addStatesFromChildren="true"
    android:foreground="@drawable/fg_card_feedback">

    <LinearLayout
        android:id="@+id/condition_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/rule_row_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_xs"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/condition_title"
                style="@style/Text.App.RuleTitle"
                android:layout_width="wrap_content" />

            <TextView
                android:id="@+id/condition_hint"
                style="@style/Text.App.RuleHint"
                android:layout_width="match_parent" />
        </LinearLayout>

        <Switch
            android:id="@+id/type_check"
            style="@style/Widget.App.Switch.RuleEditor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/condition_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <TextView
        android:id="@+id/condition_error"
        style="@style/Text.App.Error"
        android:visibility="gone" />
</LinearLayout>
