<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.App.Row"
    android:paddingStart="@dimen/space_md"
    android:paddingEnd="@dimen/space_md">

    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="@dimen/app_icon_size"
        android:layout_height="@dimen/app_icon_size"
        android:layout_marginEnd="@dimen/space_sm"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/app_name"
        style="@style/Text.App.Strong"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/space_xs"
        android:ellipsize="end"
        android:maxLines="2" />

    <TextView
        android:id="@+id/app_tag"
        style="@style/Widget.App.Tag"
        android:background="@drawable/bg_pill_level"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/level_selected_text"
        android:maxWidth="@dimen/group_tag_max_width"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />
</LinearLayout>
