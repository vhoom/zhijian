<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.App.SetupTile">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/setup_icon"
            android:layout_width="@dimen/setup_icon_size"
            android:layout_height="@dimen/setup_icon_size"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/setup_status"
            style="@style/Text.App.Caption"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_xxs"
            android:gravity="end"
            android:textColor="@color/body" />
    </LinearLayout>

    <TextView
        android:id="@+id/setup_title"
        style="@style/Text.App.Strong"
        android:layout_marginTop="@dimen/space_xs" />
</LinearLayout>
