<?xml version="1.0" encoding="utf-8"?>
<!-- 主句与单词内容保持完整；关闭再次确认时在退出按钮后新增完成操作。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <github.vhoom.zhijian.ui.interception.page.support.HeadlineScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        app:fitChallenge="true"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/interception_word_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="0dp"
            android:paddingBottom="@dimen/space_md">
            <TextView
                android:id="@+id/interception_word_title"
                style="@style/Text.App.InterceptionHero" />

            <TextView
                android:id="@+id/interception_word_status"
                style="@style/Text.App.Caption"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_3xl"
                android:textColor="@color/word_caption"
                android:visibility="gone" />
            <TextView
                android:id="@+id/interception_word_prompt"
                style="@style/Text.App.Body"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xl"
                android:singleLine="true"
                android:scrollHorizontally="true"
                android:focusable="true"
                android:lineHeight="@dimen/line_body"
                android:textColor="@color/body" />

            <ProgressBar
                android:id="@+id/interception_word_progress"
                style="@style/Widget.App.InterceptionProgress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginBottom="@dimen/space_md" />

            <GridLayout
                android:id="@+id/interception_word_choices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:rowCount="3"
                android:useDefaultMargins="false">
                <Button
                    android:id="@+id/interception_word_choice_1"
                    style="@style/Widget.App.Button.WordOption"
                    android:layout_width="0dp"
                    android:layout_row="0"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_marginEnd="@dimen/word_column_half_gap"
                    android:layout_marginBottom="@dimen/space_sm" />

                <Button
                    android:id="@+id/interception_word_choice_2"
                    style="@style/Widget.App.Button.WordOption"
                    android:layout_width="0dp"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_marginStart="@dimen/word_column_half_gap"
                    android:layout_marginBottom="@dimen/space_sm" />

                <Button
                    android:id="@+id/interception_word_choice_3"
                    style="@style/Widget.App.Button.WordOption"
                    android:layout_width="0dp"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_marginEnd="@dimen/word_column_half_gap"
                    android:layout_marginBottom="@dimen/space_sm" />

                <Button
                    android:id="@+id/interception_word_choice_4"
                    style="@style/Widget.App.Button.WordOption"
                    android:layout_width="0dp"
                    android:layout_row="1"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_marginStart="@dimen/word_column_half_gap"
                    android:layout_marginBottom="@dimen/space_sm" />

                <Button
                    android:id="@+id/interception_word_choice_5"
                    style="@style/Widget.App.Button.WordOption"
                    android:layout_width="0dp"
                    android:layout_row="2"
                    android:layout_column="0"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_marginEnd="@dimen/word_column_half_gap"
                    android:layout_marginBottom="0dp" />

                <Button
                    android:id="@+id/interception_word_choice_6"
                    style="@style/Widget.App.Button.WordOption"
                    android:layout_width="0dp"
                    android:layout_row="2"
                    android:layout_column="1"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill"
                    android:layout_marginStart="@dimen/word_column_half_gap"
                    android:layout_marginBottom="0dp" />
            </GridLayout>
            <TextView
                android:id="@+id/interception_word_feedback"
                style="@style/Text.App.Error"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_sm"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>
    </github.vhoom.zhijian.ui.interception.page.support.HeadlineScrollView>

    <Button
        android:id="@+id/interception_word_retry"
        style="@style/Widget.App.Button.WordAction"
        android:layout_width="match_parent"
        android:text="@string/interception_word_retry"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/interception_word_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="vertical">
        <Button
            android:id="@+id/interception_word_exit"
            style="@style/Widget.App.Button.WordAction" />
    </LinearLayout>
</LinearLayout>
