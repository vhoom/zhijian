<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.App.Row"
    android:minHeight="@dimen/usage_row_height">

    <ImageView
        android:id="@+id/usage_icon"
        android:layout_width="@dimen/app_icon_size"
        android:layout_height="@dimen/app_icon_size"
        android:layout_marginEnd="@dimen/space_sm"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/usage_name"
        style="@style/Text.App.Strong"
        android:layout_width="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/usage_duration"
        style="@style/Text.App.Strong" />
</LinearLayout>
