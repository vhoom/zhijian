<?xml version="1.0" encoding="utf-8"?>
<!-- 保留主句与按压控件，关闭再次确认时在退出按钮后新增完成操作。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <github.vhoom.zhijian.ui.interception.page.support.HeadlineScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="none" app:fitChallenge="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_lg" android:paddingBottom="@dimen/space_lg">
            <TextView android:id="@+id/interception_hold_title" style="@style/Text.App.InterceptionHero" />
            <Button android:id="@+id/interception_hold_button" style="@style/Widget.App.Button.HoldChallenge"
                android:layout_width="match_parent" android:layout_marginTop="@dimen/space_3xl" android:minHeight="72dp" />
            <ProgressBar android:id="@+id/interception_hold_progress"
                style="@style/Widget.App.InterceptionProgress"
                android:layout_width="match_parent" android:layout_height="3dp"
                android:layout_marginTop="@dimen/space_md" />
        </LinearLayout>
    </github.vhoom.zhijian.ui.interception.page.support.HeadlineScrollView>
    <LinearLayout android:id="@+id/interception_hold_actions"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md" android:orientation="vertical">
        <Button android:id="@+id/interception_hold_exit" style="@style/Widget.App.Button.InterceptionPrimary" />
    </LinearLayout>
</LinearLayout>
