<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.App.SettingsItem">
    <ImageView
        android:id="@+id/setup_icon"
        android:layout_width="@dimen/setup_icon_size"
        android:layout_height="@dimen/setup_icon_size"
        android:layout_marginEnd="@dimen/space_sm"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/setup_title"
        style="@style/Text.App.Body"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:textColor="@color/ink" />
    <TextView
        android:id="@+id/setup_status"
        style="@style/Text.App.Mute"
        android:layout_marginStart="@dimen/space_xs"
        android:textColor="@color/body" />
    <TextView
        style="@style/Text.App.Mute"
        android:layout_marginStart="@dimen/space_xs"
        android:importantForAccessibility="no"
        android:text="@string/icon_forward" />
</LinearLayout>
