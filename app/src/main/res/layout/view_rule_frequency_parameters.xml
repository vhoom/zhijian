<?xml version="1.0" encoding="utf-8"?>
<!-- 单条滚动频率配置；窄屏和大字体时保持整句并允许横向滚动。 -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="top"
        android:orientation="horizontal">

        <github.vhoom.zhijian.ui.component.input.InputFieldLayout
            style="@style/Widget.App.InputField"
            android:layout_width="wrap_content">
            <FrameLayout style="@style/Widget.App.RuleNumberTarget">
                <EditText
                    android:id="@+id/frequency_window_field"
                    style="@style/Widget.App.Field.RuleCompact"
                    android:hint="@string/rule_hint_required"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />
            </FrameLayout>
            <TextView android:id="@+id/frequency_window_error"
                style="@style/Text.App.InputError" />
        </github.vhoom.zhijian.ui.component.input.InputFieldLayout>

        <TextView
            style="@style/Text.App.RuleParameter"
            android:minHeight="@dimen/control_height"
            android:gravity="start|center_vertical"
            android:layout_marginStart="@dimen/space_xxs"
            android:layout_marginEnd="@dimen/space_xxs"
            android:text="@string/rule_frequency_middle" />

        <github.vhoom.zhijian.ui.component.input.InputFieldLayout
            style="@style/Widget.App.InputField"
            android:layout_width="wrap_content">
            <FrameLayout style="@style/Widget.App.RuleNumberTarget">
                <EditText
                    android:id="@+id/frequency_count_field"
                    style="@style/Widget.App.Field.RuleCompact"
                    android:importantForAutofill="no"
                    android:inputType="number" />
            </FrameLayout>
            <TextView android:id="@+id/frequency_count_error"
                style="@style/Text.App.InputError" />
        </github.vhoom.zhijian.ui.component.input.InputFieldLayout>

        <TextView
            style="@style/Text.App.RuleParameter"
            android:minHeight="@dimen/control_height"
            android:gravity="start|center_vertical"
            android:layout_marginStart="@dimen/space_xxs"
            android:text="@string/rule_unit_times" />
    </LinearLayout>
</HorizontalScrollView>
