<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <include layout="@layout/view_about_bar" />
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md">
        <TextView style="@style/Text.App.SettingsDescription"
            android:text="@string/diagnostics_privacy_detail" />
        <TextView android:id="@+id/diagnostics_build"
            style="@style/Text.App.SettingsDescription"
            android:layout_marginTop="@dimen/space_sm" />
        <github.vhoom.zhijian.ui.component.layout.RoundedLinearLayout style="@style/Widget.App.SettingsCard"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">
            <TextView android:id="@+id/btn_refresh_logs"
                style="@style/Text.App.BarAction"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/diagnostics_refresh" />
            <TextView android:id="@+id/btn_export_logs"
                style="@style/Text.App.BarAction"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/diagnostics_export" />
            <TextView android:id="@+id/btn_clear_logs"
                style="@style/Text.App.BarAction"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/diagnostics_clear" />
        </github.vhoom.zhijian.ui.component.layout.RoundedLinearLayout>
        <TextView android:id="@+id/diagnostics_status"
            style="@style/Text.App.SettingsDescription"
            android:layout_marginBottom="@dimen/space_sm"
            android:accessibilityLiveRegion="polite" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/space_md"
        android:clipToPadding="false">
        <TextView android:id="@+id/diagnostics_preview"
            style="@style/Text.App.Body"
            android:layout_width="match_parent"
            android:padding="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:fontFamily="@string/font_code"
            android:textSize="@dimen/text_caption"
            android:lineHeight="@dimen/line_small"
            android:textIsSelectable="true"
            android:textColor="@color/ink" />
    </ScrollView>
</LinearLayout>

