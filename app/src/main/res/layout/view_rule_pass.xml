<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.App.Card.RuleEditor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">
        <TextView
            style="@style/Text.App.RuleTitle"
            android:minHeight="@dimen/control_height"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_xs"
            android:labelFor="@id/field_pass"
            android:text="@string/rule_pass_value" />
        <github.vhoom.zhijian.ui.component.input.InputFieldLayout
            style="@style/Widget.App.InputField"
            android:layout_width="wrap_content">
            <FrameLayout style="@style/Widget.App.RuleNumberTarget">
                <EditText
                    android:id="@+id/field_pass"
                    style="@style/Widget.App.Field.RuleCompact"
                    android:inputType="numberDecimal"
                    android:saveEnabled="false"
                    android:importantForAutofill="no" />
            </FrameLayout>
            <TextView android:id="@+id/input_error"
                style="@style/Text.App.InputError" />
        </github.vhoom.zhijian.ui.component.input.InputFieldLayout>
        <TextView
            style="@style/Text.App.RuleParameter"
            android:minHeight="@dimen/control_height"
            android:gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_marginStart="@dimen/space_xxs"
            android:text="@string/rule_unit_minutes" />
    </LinearLayout>
    <TextView
        style="@style/Text.App.RuleHint"
        android:text="@string/rule_pass_hint" />
</LinearLayout>
