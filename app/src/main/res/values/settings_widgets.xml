<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.App.SettingsCard" parent="@style/Widget.App.SettingsGroup">
        <item name="android:padding">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <style name="Widget.App.SettingsItem" parent="@style/Widget.App.SettingsAction">
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
    </style>

    <style name="Widget.App.SettingsItem.Static" parent="@style/Widget.App.SettingsItem">
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:background">@null</item>
    </style>

    <style name="Text.App.SettingsTitle" parent="@style/Text.App.Strong">
    </style>

    <style name="Text.App.SettingsDescription" parent="@style/Text.App.Supporting">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">@dimen/space_xxs</item>
    </style>

    <style name="Widget.App.SettingsDivider" parent="@style/Widget.App.Divider">
        <item name="android:layout_marginStart">@dimen/space_md</item>
    </style>

    <style name="Widget.App.SettingsStepper" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:baselineAligned">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_settings_stepper</item>
    </style>

    <style name="Widget.App.SettingsStepButton" parent="@style/Text.App.BarAction">
        <item name="android:layout_width">@dimen/control_height</item>
        <item name="android:layout_height">@dimen/control_height</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">@dimen/text_display_md</item>
        <item name="android:textColor">@color/button_secondary_text</item>
    </style>

    <style name="Widget.App.SettingsStepField" parent="@style/Widget.App.Field">
        <item name="android:layout_width">@dimen/settings_step_field_width</item>
        <item name="android:layout_height">@dimen/control_height</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:background">@null</item>
        <item name="android:padding">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:selectAllOnFocus">true</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColorHighlight">@color/link_bg_soft</item>
    </style>
</resources>
