<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.App.DialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_button_text</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textAppearance">@style/TextAppearance.App.ButtonMd</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">@dimen/dialog_button_min_width</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:paddingStart">@dimen/space_sm</item>
        <item name="android:paddingEnd">@dimen/space_sm</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Text.App.DialogTitle" parent="@style/Text.App.Heading">
        <item name="android:textAppearance">@style/TextAppearance.App.DialogTitle</item>
        <item name="android:textStyle">normal</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Widget.App.DatePicker" parent="@android:style/Widget.Material.DatePicker">
        <item name="android:headerBackground">@color/canvas_soft_2</item>
    </style>

    <style name="Widget.App.TimePicker" parent="@android:style/Widget.Material.TimePicker">
        <item name="android:headerBackground">@color/canvas_soft_2</item>
        <item name="android:numbersBackgroundColor">@color/canvas_soft_2</item>
        <item name="android:numbersSelectorColor">@color/primary</item>
        <item name="android:numbersTextColor">@color/picker_number_text</item>
        <item name="android:numbersInnerTextColor">@color/picker_number_text</item>
        <item name="android:amPmTextColor">@color/picker_header_text</item>
    </style>

    <style name="Widget.App.CalendarView" parent="@android:style/Widget.Material.CalendarView">
        <item name="android:weekDayTextAppearance">@style/TextAppearance.App.Caption</item>
        <item name="android:dateTextAppearance">@style/TextAppearance.App.CalendarDay</item>
    </style>

    <style name="TextAppearance.App.CalendarDay" parent="@style/TextAppearance.App.BodyMd">
        <item name="android:textColor">@color/picker_number_text</item>
    </style>
</resources>
