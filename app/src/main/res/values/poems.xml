<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string-array name="daily_poems">
        <!-- ========== 王维 ========== -->
        <!-- 王维 · 山水田园 · 自然清景 -->
        <item>空山新雨后，天气晚来秋</item>
        <item>竹喧归浣女，莲动下渔舟</item>

        <!-- 王维 · 思乡 · 怀人 · 离别 -->
        <item>君自故乡来，应知故乡事</item>
        <item>独在异乡为异客，每逢佳节倍思亲</item>
        <item>劝君更尽一杯酒，西出阳关无故人</item>
        <item>红豆生南国，春来发几枝</item>
        <item>愿君多采撷，此物最相思</item>

        <!-- 王维 · 其他 · 田园闲适 -->
        <item>随意春芳歇，王孙自可留</item>
        <item>君问穷通理，渔歌入浦深</item>
        <item>倚杖柴门外，临风听暮蝉</item>
        <item>野老念牧童，倚杖候荆扉</item>
        <item>田夫荷锄至，相见语依依</item>

        <!-- ========== 诸葛亮 ========== -->
        <!-- 诸葛亮 · 人生哲理 · 修身 -->
        <item>非淡泊无以明志，非宁静无以致远</item>
        <item>静以修身，俭以养德</item>

        <!-- ========== 陶渊明 ========== -->
        <!-- 陶渊明 · 山水田园 · 隐逸 -->
        <item>采菊东篱下，悠然见南山</item>

        <!-- 陶渊明 · 禅理 · 静观 · 物我两忘 -->
        <item>此中有真意，欲辨已忘言</item>

        <!-- 陶渊明 · 惜时 · 时光易逝 -->
        <item>盛年不重来，一日难再晨，及时当勉励，岁月不待人</item>

        <!-- 陶渊明 · 励志 · 进取 -->
        <item>精卫衔微木，将以填沧海</item>
        <item>刑天舞干戚，猛志固常在</item>

        <!-- 陶渊明 · 人生哲理 · 旷达 -->
        <item>人生似幻化，终当归空无</item>

        <!-- 陶渊明 · 读书治学 -->
        <item>奇文共欣赏，疑义相与析</item>

        <!-- ========== 李涉 ========== -->
        <!-- 李涉 · 禅意 · 隐逸 -->
        <item>因过竹院逢僧话，偷得浮生半日闲</item>

        <!-- ========== 程颢 ========== -->
        <!-- 程颢 · 禅理 · 静观 -->
        <item>万物静观皆自得，四时佳兴与人同</item>
        <item>云淡风轻近午天，傍花随柳过前川</item>

        <!-- ========== 王籍 ========== -->
        <!-- 王籍 · 山水田园 · 自然清景 -->
        <item>蝉噪林逾静，鸟鸣山更幽</item>

        <!-- ========== 韦应物 ========== -->
        <!-- 韦应物 · 山水田园 · 自然清景 -->
        <item>独怜幽草涧边生，上有黄鹂深树鸣</item>
        <item>春潮带雨晚来急，野渡无人舟自横</item>

        <!-- 韦应物 · 禅意 · 空寂 -->
        <item>空山松子落，幽人应未眠</item>

        <!-- ========== 张先 ========== -->
        <!-- 张先 · 闲适 · 生活情趣 -->
        <item>行云去后遥山暝，已放笙歌池院静</item>
        <item>中庭月色正清明，无数杨花过无影</item>

        <!-- ========== 颜真卿 ========== -->
        <!-- 颜真卿 · 读书治学 · 惜时劝学 -->
        <item>黑发不知勤学早，白首方悔读书迟</item>

        <!-- ========== 王贞白 ========== -->
        <!-- 王贞白 · 读书治学 · 惜时劝学 -->
        <item>读书不觉已春深，一寸光阴一寸金</item>

        <!-- ========== 于谦 ========== -->
        <!-- 于谦 · 读书治学 -->
        <item>书卷多情似故人，晨昏忧乐每相亲</item>
        <item>眼前直下三千字，胸次全无一点尘</item>
        <item>活水源流随处满，东风花柳逐时新</item>

        <!-- 于谦 · 咏物言志 · 品格气节 -->
        <item>千锤万凿出深山，烈火焚烧若等闲</item>

        <!-- ========== 陆九渊 ========== -->
        <!-- 陆九渊 · 读书治学 -->
        <item>读书切戒在慌忙，涵泳工夫兴味长</item>
        <item>未晓不妨权放过，切身须要急思量</item>

        <!-- ========== 杜荀鹤 ========== -->
        <!-- 杜荀鹤 · 读书治学 · 惜时劝学 -->
        <item>少年辛苦终身事，莫向光阴惰寸功</item>
        <item>卖却屋边三亩地，添成窗下一床书</item>

        <!-- ========== 陈师道 ========== -->
        <!-- 陈师道 · 读书治学 -->
        <item>书当快意读易尽，客有可人期不来</item>

        <!-- ========== 汪洙 ========== -->
        <!-- 汪洙 · 读书治学 -->
        <item>学向勤中得，萤窗万卷书</item>
        <item>三冬今足用，谁笑腹空虚</item>

        <!-- ========== 陈著 ========== -->
        <!-- 陈著 · 惜时 · 时光易逝 -->
        <item>花有重开日，人无再少年</item>

        <!-- ========== 郑燮 ========== -->
        <!-- 郑燮 · 咏物言志 · 品格气节 -->
        <item>千磨万击还坚劲，任尔东西南北风</item>
        <item>咬定青山不放松，立根原在破岩中</item>

        <!-- ========== 韩愈 ========== -->
        <!-- 韩愈 · 读书治学 -->
        <item>业精于勤，荒于嬉；行成于思，毁于随</item>
        <item>读书患不多，思义患不明</item>
        <item>患足己不学，既学患不行</item>

        <!-- 韩愈 · 山水田园 · 自然清景 -->
        <item>天街小雨润如酥，草色遥看近却无</item>
        <item>最是一年春好处，绝胜烟柳满皇都</item>

        <!-- ========== 黄檗禅师 ========== -->
        <!-- 黄檗禅师 · 励志 · 进取 -->
        <item>不经一番寒彻骨，怎得梅花扑鼻香</item>

        <!-- ========== 袁枚 ========== -->
        <!-- 袁枚 · 咏物言志 · 品格气节 -->
        <item>白日不到处，青春恰自来</item>

        <!-- ========== 李贺 ========== -->
        <!-- 李贺 · 励志 · 壮志 -->
        <item>少年心事当拿云，谁念幽寒坐呜呃</item>

        <!-- 李贺 · 惜时 · 时光易逝 -->
        <item>少年安得长少年，海波尚变为桑田</item>
        <item>飞光飞光，劝尔一杯酒</item>
        <item>吾不识青天高，黄地厚，唯见月寒日暖，来煎人寿</item>

        <!-- 李贺 · 闲适 · 生活情趣 -->
        <item>小槽酒滴真珠红，烹龙炮凤玉脂泣</item>
        <item>吹龙笛，击鼍鼓，皓齿歌，细腰舞</item>
        <item>况是青春日将暮，桃花乱落如红雨</item>

        <!-- ========== 朱敦儒 ========== -->
        <!-- 朱敦儒 · 闲适 · 旷达 -->
        <item>我是清都山水郎，天教分付与疏狂</item>
        <item>春雨细如尘，楼外柳丝黄湿</item>

        <!-- ========== 傅玄 ========== -->
        <!-- 傅玄 · 惜时 · 时光易逝 -->
        <item>志士惜日短，愁人知夜长</item>

        <!-- ========== 王冕 ========== -->
        <!-- 王冕 · 咏物言志 · 品格气节 -->
        <item>不要人夸好颜色，只留清气满乾坤</item>

        <!-- ========== 赵翼 ========== -->
        <!-- 赵翼 · 励志 · 进取 -->
        <item>江山代有才人出，各领风骚数百年</item>

        <!-- ========== 虞世南 ========== -->
        <!-- 虞世南 · 咏物言志 · 品格气节 -->
        <item>居高声自远，非是藉秋风</item>

        <!-- ========== 郑思肖 ========== -->
        <!-- 郑思肖 · 咏物言志 · 品格气节 -->
        <item>花开不并百花丛，独立疏篱趣未穷</item>
        <item>宁可枝头抱香死，何曾吹落北风中</item>

        <!-- ========== 卢钺 ========== -->
        <!-- 卢钺 · 咏物言志 -->
        <item>梅须逊雪三分白，雪却输梅一段香</item>

        <!-- ========== 林逋 ========== -->
        <!-- 林逋 · 咏物言志 -->
        <item>疏影横斜水清浅，暗香浮动月黄昏</item>

        <!-- ========== 元稹 ========== -->
        <!-- 元稹 · 咏物言志 -->
        <item>不是花中偏爱菊，此花开尽更无花</item>

        <!-- 元稹 · 愁绪 · 离恨 -->
        <item>曾经沧海难为水，除却巫山不是云</item>

        <!-- ========== 罗隐 ========== -->
        <!-- 罗隐 · 咏物言志 -->
        <item>采得百花成蜜后，为谁辛苦为谁甜</item>
        <item>不论平地与山尖，无限风光尽被占</item>

        <!-- 罗隐 · 旷达 · 人生哲理 -->
        <item>得即高歌失即休，多愁多恨亦悠悠</item>
        <item>今朝有酒今朝醉，明日愁来明日愁</item>

        <!-- ========== 王之涣 ========== -->
        <!-- 王之涣 · 励志 · 进取 -->
        <item>欲穷千里目，更上一层楼</item>

        <!-- 王之涣 · 家国 · 边塞 -->
        <item>黄河远上白云间，一片孤城万仞山</item>
        <item>羌笛何须怨杨柳，春风不度玉门关</item>

        <!-- ========== 曹操 ========== -->
        <!-- 曹操 · 励志 · 壮志 -->
        <item>老骥伏枥，志在千里</item>
        <item>烈士暮年，壮心不已</item>

        <!-- 曹操 · 惜时 · 人生感慨 -->
        <item>对酒当歌，人生几何</item>
        <item>月明星稀，乌鹊南飞</item>

        <!-- ========== 高适 ========== -->
        <!-- 高适 · 思乡 · 怀人 · 离别 -->
        <item>莫愁前路无知己，天下谁人不识君</item>

        <!-- ========== 张九龄 ========== -->
        <!-- 张九龄 · 咏物言志 -->
        <item>草木有本心，何求美人折</item>

        <!-- 张九龄 · 思乡 · 怀人 -->
        <item>海上生明月，天涯共此时</item>
        <item>相知无远近，万里尚为邻</item>

        <!-- ========== 王勃 ========== -->
        <!-- 王勃 · 励志 · 壮志 -->
        <item>穷且益坚，不坠青云之志</item>

        <!-- 王勃 · 思乡 · 怀人 -->
        <item>海内存知己，天涯若比邻</item>

        <!-- 王勃 · 山水田园 -->
        <item>落霞与孤鹜齐飞，秋水共长天一色</item>

        <!-- ========== 宋之问 ========== -->
        <!-- 宋之问 · 思乡 · 怀人 -->
        <item>近乡情更怯，不敢问来人</item>

        <!-- ========== 王建 ========== -->
        <!-- 王建 · 思乡 · 怀人 -->
        <item>今夜月明人尽望，不知秋思落谁家</item>

        <!-- ========== 岑参 ========== -->
        <!-- 岑参 · 山水田园 · 自然清景 -->
        <item>忽如一夜春风来，千树万树梨花开</item>

        <!-- 岑参 · 思乡 · 怀人 -->
        <item>马上相逢无纸笔，凭君传语报平安</item>

        <!-- ========== 贺知章 ========== -->
        <!-- 贺知章 · 山水田园 · 咏春 -->
        <item>碧玉妆成一树高，万条垂下绿丝绦</item>
        <item>不知细叶谁裁出，二月春风似剪刀</item>

        <!-- 贺知章 · 思乡 · 怀人 -->
        <item>少小离家老大回，乡音无改鬓毛衰</item>
        <item>儿童相见不相识，笑问客从何处来</item>

        <!-- ========== 叶绍翁 ========== -->
        <!-- 叶绍翁 · 山水田园 · 咏春 -->
        <item>春色满园关不住，一枝红杏出墙来</item>
        <item>应怜屐齿印苍苔，小扣柴扉久不开</item>

        <!-- ========== 高骈 ========== -->
        <!-- 高骈 · 山水田园 · 自然清景 -->
        <item>绿树阴浓夏日长，楼台倒影入池塘</item>
        <item>水晶帘动微风起，满架蔷薇一院香</item>

        <!-- ========== 范成大 ========== -->
        <!-- 范成大 · 闲适 · 田园童趣 -->
        <item>梅子金黄杏子肥，麦花雪白菜花稀</item>
        <item>童孙未解供耕织，也傍桑阴学种瓜</item>
        <item>昼出耘田夜绩麻，村庄儿女各当家</item>

        <!-- ========== 崔护 ========== -->
        <!-- 崔护 · 思乡 · 怀人 -->
        <item>人面不知何处去，桃花依旧笑春风</item>

        <!-- ========== 杜秋娘 ========== -->
        <!-- 杜秋娘 · 惜时 · 劝学 -->
        <item>劝君莫惜金缕衣，劝君惜取少年时</item>
        <item>花开堪折直须折，莫待无花空折枝</item>

        <!-- ========== 张若虚 ========== -->
        <!-- 张若虚 · 人生哲理 · 时光 -->
        <item>春江潮水连海平，海上明月共潮生</item>
        <item>江畔何人初见月？江月何年初照人</item>
        <item>人生代代无穷已，江月年年望相似</item>
        <item>不知江月待何人，但见长江送流水</item>

        <!-- ========== 刘希夷 ========== -->
        <!-- 刘希夷 · 惜时 · 时光易逝 -->
        <item>年年岁岁花相似，岁岁年年人不同</item>

        <!-- ========== 张志和 ========== -->
        <!-- 张志和 · 山水田园 · 隐逸 -->
        <item>西塞山前白鹭飞，桃花流水鳜鱼肥</item>
        <item>青箬笠，绿蓑衣，斜风细雨不须归</item>

        <!-- ========== 唐寅 ========== -->
        <!-- 唐寅 · 闲适 · 旷达 -->
        <item>桃花坞里桃花庵，桃花庵下桃花仙</item>
        <item>别人笑我太疯癫，我笑他人看不穿</item>
        <item>但愿老死花酒间，不愿鞠躬车马前</item>

        <!-- ========== 胡令能 ========== -->
        <!-- 胡令能 · 闲适 · 童趣 -->
        <item>蓬头稚子学垂纶，侧坐莓苔草映身</item>
        <item>路人借问遥招手，怕得鱼惊不应人</item>

        <!-- ========== 吕岩 ========== -->
        <!-- 吕岩 · 闲适 · 田园 -->
        <item>草铺横野六七里，笛弄晚风三四声</item>
        <item>归来饱饭黄昏后，不脱蓑衣卧月明</item>

        <!-- ========== 高鼎 ========== -->
        <!-- 高鼎 · 山水田园 · 童趣 -->
        <item>草长莺飞二月天，拂堤杨柳醉春烟</item>
        <item>儿童散学归来早，忙趁东风放纸鸢</item>

        <!-- ========== 王湾 ========== -->
        <!-- 王湾 · 山水田园 · 自然清景 -->
        <item>潮平两岸阔，风正一帆悬</item>
        <item>海日生残夜，江春入旧年</item>
        <item>客路青山外，行舟绿水前</item>

        <!-- 王湾 · 思乡 · 怀人 -->
        <item>乡书何处达？归雁洛阳边</item>

        <!-- ========== 范仲淹 ========== -->
        <!-- 范仲淹 · 愁绪 · 离恨 -->
        <item>山映斜阳天接水，芳草无情，更在斜阳外</item>
        <item>碧云天，黄叶地，秋色连波，波上寒烟翠</item>
        <item>明月楼高休独倚，酒入愁肠，化作相思泪</item>

        <!-- ========== 梅尧臣 ========== -->
        <!-- 梅尧臣 · 山水田园 -->
        <item>野凫眠岸有闲意，老树着花无丑枝</item>
        <item>霜落熊升树，林空鹿饮溪</item>

        <!-- ========== 宋祁 ========== -->
        <!-- 宋祁 · 山水田园 · 咏春 -->
        <item>绿杨烟外晓寒轻，红杏枝头春意闹</item>

        <!-- 宋祁 · 惜时 · 人生感慨 -->
        <item>浮生长恨欢娱少，肯爱千金轻一笑</item>
        <item>为君持酒劝斜阳，且向花间留晚照</item>

        <!-- ========== 李煜 ========== -->
        <!-- 李煜 · 愁绪 · 离恨 · 伤感 -->
        <item>世事漫随流水，算来一梦浮生</item>
        <item>春花秋月何时了？往事知多少</item>
        <item>问君能有几多愁？恰似一江春水向东流</item>
        <item>无言独上西楼，月如钩，寂寞梧桐深院锁清秋</item>
        <item>剪不断，理还乱，是离愁，别是一般滋味在心头</item>
        <item>胭脂泪，相留醉，几时重？自是人生长恨水长东</item>
        <item>离恨恰如春草，更行更远还生</item>
        <item>还似旧时游上苑，车如流水马如龙</item>
        <item>雕栏玉砌应犹在，只是朱颜改</item>

        <!-- ========== 柳永 ========== -->
        <!-- 柳永 · 愁绪 · 离恨 -->
        <item>衣带渐宽终不悔，为伊消得人憔悴</item>
        <item>今宵酒醒何处？杨柳岸，晓风残月</item>
        <item>多情自古伤离别，更那堪冷落清秋节</item>
        <item>念去去，千里烟波，暮霭沉沉楚天阔</item>
        <item>便纵有千种风情，更与何人说</item>
        <item>对潇潇暮雨洒江天，一番洗清秋</item>
        <item>渐霜风凄紧，关河冷落，残照当楼</item>
        <item>不忍登高临远，望故乡渺邈，归思难收</item>
        <item>想佳人妆楼颙望，误几回、天际识归舟</item>
        <item>草色烟光残照里，无言谁会凭阑意</item>
        <item>拟把疏狂图一醉，对酒当歌，强乐还无味</item>

        <!-- 柳永 · 山水田园 · 城市风光 -->
        <item>有三秋桂子，十里荷花</item>
        <item>羌管弄晴，菱歌泛夜，嬉嬉钓叟莲娃</item>

        <!-- ========== 晏殊 ========== -->
        <!-- 晏殊 · 惜时 · 人生感慨 -->
        <item>一曲新词酒一杯，去年天气旧亭台</item>
        <item>无可奈何花落去，似曾相识燕归来</item>
        <item>昨夜西风凋碧树，独上高楼，望尽天涯路</item>
        <item>梨花院落溶溶月，柳絮池塘淡淡风</item>
        <item>满目山河空念远，落花风雨更伤春</item>
        <item>不如怜取眼前人</item>
        <item>天涯地角有穷时，只有相思无尽处</item>
