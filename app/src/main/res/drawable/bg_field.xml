<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/disabled_surface" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="@dimen/divider_height" android:color="@color/hairline" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_soft" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="1dp" android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_soft_2" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="@dimen/divider_height" android:color="@color/hairline_strong" />
        </shape>
    </item>
</selector>
