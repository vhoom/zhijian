<?xml version="1.0" encoding="utf-8"?>
<!-- 规则数字框使用浅灰矩形表面；焦点和禁用态复用深浅色语义资源。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/disabled_surface" />
            <stroke android:width="@dimen/divider_height" android:color="@color/hairline" />
            <corners android:radius="@dimen/rule_input_radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_soft" />
            <stroke android:width="@dimen/divider_height" android:color="@color/primary" />
            <corners android:radius="@dimen/rule_input_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas_soft_2" />
            <stroke android:width="@dimen/divider_height" android:color="@color/hairline" />
            <corners android:radius="@dimen/rule_input_radius" />
        </shape>
    </item>
</selector>
